datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Doctor {
  id          String       @id @default(cuid())
  name        String
  specialty   String       @default("General")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  schedules   Schedule[]
  dailyCounts DailyCount[]
}

model Schedule {
  id          String       @id @default(cuid())
  doctorId    String
  dayOfWeek   Int          // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime   String       // Format: "HH:mm" (24h)
  endTime     String       // Format: "HH:mm" (24h)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dailyCounts DailyCount[]

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([doctorId])
  @@index([dayOfWeek])
}

model DailyCount {
  id           String    @id @default(cuid())
  doctorId     String
  scheduleId   String?   // Links to specific shift slot if scheduled
  date         String    // Format: "YYYY-MM-DD"
  patientCount Int       @default(0)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  doctor       Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  schedule     Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@unique([doctorId, date, scheduleId])
  @@index([date])
  @@index([doctorId])
  @@index([scheduleId])
}
