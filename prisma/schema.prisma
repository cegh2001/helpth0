datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

model Doctor {
  id            String         @id @default(cuid())
  name          String
  specialty     String         @default("General")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  schedules     Schedule[]
  dailyCounts   DailyCount[]
  consultations Consultation[]
}

model Schedule {
  id          String       @id @default(cuid())
  doctorId    String
  dayOfWeek   Int          // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime   String       // Format: "HH:mm" (24h)
  endTime     String       // Format: "HH:mm" (24h)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dailyCounts DailyCount[]

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([doctorId])
  @@index([dayOfWeek])
}

model DailyCount {
  id                    String    @id @default(cuid())
  doctorId              String
  scheduleId            String?
  slotKey               String    @default("")
  scheduleSnapshotStart String?
  scheduleSnapshotEnd   String?
  date                  String
  patientCount          Int       @default(0)
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  doctor                Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  schedule              Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@unique([doctorId, date, slotKey])
  @@index([date])
  @@index([doctorId])
  @@index([scheduleId])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Patient {
  id            String         @id @default(cuid())
  cedula        String?        @unique
  fullName      String
  birthDate     String?
  phone         String?
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  consultations Consultation[]
  exams         MedicalExam[]

  @@index([cedula])
  @@index([fullName])
}

model Consultation {
  id             String   @id @default(cuid())
  date           String   // Format: "YYYY-MM-DD"
  patientId      String?
  patient        Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName    String
  patientCedula  String?
  patientPhone   String?
  patientAddress String?

  doctorId       String?
  doctor         Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  doctorName     String
  specialty      String

  amountPointBs  Float    @default(0) // Punto
  amountMobileBs Float    @default(0) // Pago Movil
  amountCashBs   Float    @default(0) // Efectivo Bs
  bcvRate        Float    @default(0) // Tasa BCV
  amountUsd      Float    @default(0) // Divisas ($)
  totalBs        Float    @default(0) // Total en Bs

  status              String   @default("COMPLETO") // COMPLETO, EXONERADO, PENDIENTE DE PAGO, etc.
  exonerationPercent  Float    @default(0) // Porcentaje exonerado (0-100)
  exoneratedAmountUsd Float    @default(0) // Monto en $ exonerado
  observations        String?

  importHash     String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
  @@index([doctorId])
  @@index([doctorName])
  @@index([specialty])
  @@index([status])
}

model MedicalExam {
  id                  String   @id @default(cuid())
  date                String   // Format: "YYYY-MM-DD"
  patientId           String?
  patient             Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName         String
  patientCedula       String?
  patientBirthDate    String?
  patientPhone        String?
  patientAddress      String?
  examName            String?

  amountPointBs       Float    @default(0) // Punto
  amountMobileBs      Float    @default(0) // Pago Movil
  amountCashBs        Float    @default(0) // Efectivo Bs
  bcvRate             Float    @default(0) // Tasa BCV
  amountUsd           Float    @default(0) // Divisas ($)
  totalBs             Float    @default(0) // Total en Bs

  status              String   @default("COMPLETO") // COMPLETO, EXONERADO, PENDIENTE, REPETICION, etc.
  exonerationPercent  Float    @default(0)
  exoneratedAmountUsd Float    @default(0)
  observations        String?

  importHash          String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([date])
  @@index([patientName])
  @@index([patientCedula])
  @@index([status])
}

model TherapySession {
  id             String   @id @default(cuid())
  date           String   // Format: "YYYY-MM-DD"
  therapistName  String
  specialty      String
  dayOfWeekName  String   // Always derived from `date`, never trusted from the workbook
  sessionIndex   Int      // 1..N positional index of the session inside its therapist/day block

  amountPointBs  Float    @default(0) // Punto
  amountMobileBs Float    @default(0) // Pago Movil
  amountCashBs   Float    @default(0) // Efectivo Bs
  bcvRate        Float    @default(0) // Tasa BCV
  amountUsd      Float    @default(0) // Divisas ($)
  totalBs        Float    @default(0) // Total facturado en Bs

  status              String   @default("COMPLETO") // COMPLETO, EXONERADO 100%, PENDIENTE DE PAGO, etc.
  exonerationPercent  Float    @default(0)
  exoneratedAmountUsd Float    @default(0)
  observations        String?

  importHash     String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
  @@index([therapistName])
  @@index([specialty])
  @@index([status])
}

model SpecialtyRate {
  id              String   @id @default(cuid())
  specialty       String   @unique
  standardRateUsd Float    @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([specialty])
}


